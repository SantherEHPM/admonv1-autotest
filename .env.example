# URL del frontend bajo prueba (local por defecto)
BASE_URL=http://localhost:5173
# API GAS (proyecto admonv1-testapi) - recibe POST ?action=register (acceso anónimo)
GAS_URL=https://script.google.com/macros/s/AKfycbzaAfaLi2QNKVFoU8XkcZh_gZ0Tr8MVFDZUNcqYvUxBSqs-tM_vUfAP6yiCL_gj76qD/exec
# Credenciales del residente de prueba (vienen del seed del backend)
TEST_EMAIL=residente@test.com
TEST_PASSWORD=123456
# true = sin ventana (CI); false = navegador visible
HEADLESS=true
# Pausa en ms entre interacciones para ver la prueba
SLOW_MO_MS=700
# local = verifica por API + reinicia servidores | prod = duckdns sin API ni reinicios
TEST_ENV=local
# Reinicio de servidores antes de cada prueba (solo local): no|session|test
RESET_BACKEND=test
RESET_FRONTEND=test
# Opcional: si front/back NO están junto a esta carpeta, indica dónde están
#AUTOTEST_WORKSPACE=/ruta/a/HorizontalApp
#AUTOTEST_BACKEND=/ruta/a/admonv1-backend
#AUTOTEST_FRONTEND=/ruta/a/admonv1-frontend
